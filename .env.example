# =============================================================================
# Rosy Discord Bot - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit your .env file to version control!

# -----------------------------------------------------------------------------
# RAILWAY DEPLOYMENT:
# -----------------------------------------------------------------------------
# For Railway deployment, ADD these variables in Railway Dashboard > Variables:
# - DISCORD_BOT_TOKEN = your Discord bot token
# - DATABASE_URL = Railway provides this automatically for PostgreSQL
# - OPENROUTER_API_KEY = your OpenRouter API key
# - ENCRYPTION_SECRET = generate with: python -c "import secrets; print(secrets.token_hex(32))"
#
# Railway will auto-detect all other settings. Just add your credentials!

# -----------------------------------------------------------------------------
# Discord Bot Configuration
# -----------------------------------------------------------------------------
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# PostgreSQL connection URL (use postgresql+asyncpg:// for async)
# Format: postgresql+asyncpg://user:password@host:port/database
# For Railway deployment, Railway provides DATABASE_URL automatically
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/rosy_bot

# -----------------------------------------------------------------------------
# AI Provider Configuration
# -----------------------------------------------------------------------------
# OpenRouter API Key (get from https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter default model
# Options: openrouter/auto (free routing), openai/gpt-3.5-turbo, anthropic/claude-3-haiku, etc.
OPENROUTER_DEFAULT_MODEL=openrouter/auto

# Optional: OpenRouter site info for ranking
OPENROUTER_SITE_URL=https://github.com/Nithin-563/Rosy-Bot
OPENROUTER_SITE_NAME=Rosy Bot

# -----------------------------------------------------------------------------
# Security Configuration
# -----------------------------------------------------------------------------
# Encryption secret for API keys (generate with: python -c "import secrets; print(secrets.token_hex(32))")
ENCRYPTION_SECRET=your_encryption_secret_here

# Bot owner Discord user ID (for admin commands)
BOT_OWNER_ID=your_discord_user_id_here

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Set to "true" for JSON formatted logs (production)
LOG_JSON=false
